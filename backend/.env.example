# Copy to .env and fill in. FIXTURE mode needs no credentials and is what the
# eval suite runs in, so the deterministic layer and the whole test suite work
# without any Azure setup.
PROVIDER_MODE=fixture

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_CHAT_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21

# Determinism. See ARCHITECTURE.md section 10. The reproducibility experiment
# varies these deliberately; leave them alone for normal runs.
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_SEED=7

# MCP server. A real separate process over streamable HTTP; MCP_INPROCESS=true
# mounts it in-process for tests instead.
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_URL=http://127.0.0.1:8766/mcp
MCP_INPROCESS=false

# LangSmith tracing (optional).
# Key from https://smith.langchain.com -> settings -> API Keys. A personal access
# token (lsv2_pt_...) is right for local work; use a service key (lsv2_sk_...) in CI.
# The LANGSMITH_* names are the newer equivalents of these; set one pair, not both.
# On EU data residency also set LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=screening-note-agent

LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173
